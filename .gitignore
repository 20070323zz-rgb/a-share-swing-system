.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local virtual environment
.venv/
venv/
env/

# IDE / local machine state
.idea/
.vscode/
.env
.env.*
.envTAB

# JavaScript dependencies are restored from package lock files.
app/frontend/node_modules/
desktop/tauri/node_modules/

# Runtime logs
logs/
*.log

# Temporary local files
.pycache_check/
*.tmp
*.bak
=2.31.0

# Local Baostock batch/probe status snapshots and duplicate report copies
reports/data_update_status.baostock_*batch*.json
reports/data_update_status.baostock_probe*.json
reports/report_taxonomy_feasibility_study_副本.md

# Manual raw imports can contain ad-hoc local files. Keep directory markers.
raw/*
!raw/.gitkeep
data/raw/*
!data/raw/.gitkeep

# Run-scoped Tushare proof payloads are local evidence, never committed.
data/staging/tushare_minimal_proof/
